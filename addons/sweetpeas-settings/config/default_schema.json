{
	"version": 1,
	"sections": [
		{
			"id": "gameplay",
			"settings": [
				{
					"key": "language",
					"type": "option",
					"default": "en",
					"options": { "English": "en", "Spanish": "es" }
				},
				{
					"key": "sensitivity",
					"label": "Mouse Sensitivity",
					"type": "slider",
					"default": 1.0,
					"min": 0.1,
					"max": 5.0,
					"step": 0.1
				}
			]
		},
		{
			"id": "graphics",
			"settings": [
				{
					"key": "resolution",
					"type": "option",
					"default": "1920x1080",
					"options": ["1920x1080", "1280x720"]
				},
				{
					"key": "display_mode",
					"type": "option",
					"default": 0,
					"options": { "Windowed": 0, "Borderless": 1, "Fullscreen": 2 }
				},
				{
					"key": "vsync",
					"label": "VSync",
					"type": "toggle",
					"default": false
				},
				{
					"key": "max_fps",
					"label": "Max FPS",
					"type": "spinbox",
					"default": 60,
					"min": 30,
					"max": 240,
					"step": 1
				}
			]
		},
		{
			"id": "audio",
			"settings": [
				{
					"type": "numeric_slider",
					"default": 0.1,
					"min": 0.0,
					"max": 1.0,
					"step": 0.01,
					"suffix": "%",
					"display_scale": 100,
					"keys": [
						"master_volume",
						"music_volume",
						"sfx_volume",
						"ui_volume"
					]
				}
			]
		},
		{
			"id": "controls",
			"settings": []
		}
	]
}
